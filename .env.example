# ── Snack Overflow – Root .env.example ─────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=snackoverflow
POSTGRES_PASSWORD=snackoverflow
POSTGRES_DB=snackoverflow

# Backend connection string – host is 'db' inside Docker, 'localhost' outside
# Supports postgres://, postgresql://, or postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://snackoverflow:snackoverflow@db:5432/snackoverflow

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-must-be-32-chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins the browser is allowed to call from (no trailing slash)
CORS_ORIGINS=http://localhost

# ── App ─────────────────────────────────────────────────────────────────────
ENV=production

# Set to 'true' to auto-seed demo users + snacks on backend startup
SEED_ON_START=false

# Leave 'true' to enable /docs and /redoc Swagger UI for reviewers; 'false' for private enterprise
ENABLE_DOCS=true

# ── Frontend (baked into the Vite bundle at build time) ──────────────────────
# This is the URL the BROWSER uses to reach the API (e.g. https://snackoverflow-api.onrender.com)
VITE_API_BASE_URL=http://localhost:8000
